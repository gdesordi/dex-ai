{
  "name": "dex",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.1.0",
  "publisher": "sordi",
  "license": "SEE LICENSE IN license.MD",
  "repository": {
    "type": "git",
    "url": "https://github.com/gdesordi/dex-ai/"
  },
  "icon": "media/dex-icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dex.downloadSkills",
        "title": "%command.downloadSkills.title%",
        "category": "%command.category%"
      },
      {
        "command": "dex.openSkillsFolder",
        "title": "%command.openSkillsFolder.title%",
        "category": "%command.category%"
      },
      {
        "command": "dex.addSkillsToWorkspace",
        "title": "%command.addSkillsToWorkspace.title%",
        "category": "%command.category%"
      },
      {
        "command": "dex.configureSkills",
        "title": "%command.configureSkills.title%",
        "category": "%command.category%"
      },
      {
        "command": "dex.checkSkillsUpdates",
        "title": "%command.checkSkillsUpdates.title%",
        "category": "%command.category%"
      },
      {
        "command": "dex.addDefaultSource",
        "title": "%command.addDefaultSource.title%",
        "category": "%command.category%",
        "icon": "$(repo)"
      },
      {
        "command": "dex.addSource",
        "title": "%command.addSource.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "dex.openSyncConfig",
        "title": "%command.openSyncConfig.title%",
        "category": "%command.category%",
        "icon": "$(json)"
      },
      {
        "command": "dex.openSourceRepository",
        "title": "%command.openSourceRepository.title%",
        "category": "%command.category%",
        "icon": "$(link-external)"
      },
      {
        "command": "dex.removeSource",
        "title": "%command.removeSource.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "dex.skillSources",
          "name": "%view.skillSources.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dex.addSource",
          "when": "view == dex.skillSources",
          "group": "navigation@1"
        },
        {
          "command": "dex.openSyncConfig",
          "when": "view == dex.skillSources",
          "group": "navigation@3"
        },
        {
          "command": "dex.addDefaultSource",
          "when": "view == dex.skillSources",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dex.openSourceRepository",
          "when": "view == dex.skillSources && viewItem == dexSource",
          "group": "inline@1"
        },
        {
          "command": "dex.removeSource",
          "when": "view == dex.skillSources && viewItem == dexSource",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.7.2"
  }
}
